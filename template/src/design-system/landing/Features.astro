---
// Landing_Section: Features / Destacados (Req 12.1).
//
// Direccion editorial/nature (estilo Nourish): cabecera con `eyebrow` + titulo
// + `intro` opcional (via UI_Component `Section`) y una cuadricula de tarjetas
// (`Grid` + `Card`), una por destacado (`content.items[]`). Cada item puede
// traer una `image` (se usa el area de medios de la Card) y marcarse como
// `highlight` para un realce sutil de acento basado en tokens.
//
// Toda la apariencia deriva de variables CSS de Design_Tokens.
//
// Render defensivo (Req 12.5): si no hay destacados con contenido, la seccion
// se omite por completo (no se renderiza nada).
import Section from "../ui/Section.astro";
import Grid from "../ui/Grid.astro";
import Card from "../ui/Card.astro";

interface FeatureItem {
  title?: string;
  description?: string;
  /** Imagen opcional del destacado (area de medios de la Card). */
  image?: string;
  /** Texto alternativo de la imagen. */
  imageAlt?: string;
  /** Icono opcional del destacado (chip de acento en la Card). */
  icon?: string;
  /** Marca el destacado como resaltado (realce de acento sutil). */
  highlight?: boolean;
}
interface FeaturesContent {
  /** Etiqueta editorial opcional sobre el titulo (kicker). */
  eyebrow?: string;
  title?: string;
  /** Parrafo lead opcional bajo el titulo. */
  intro?: string;
  items?: FeatureItem[];
}
interface Props {
  content?: FeaturesContent;
}

const { content } = Astro.props;

const eyebrow = content?.eyebrow?.trim() || "Qué te espera";
const title = content?.title?.trim();
const intro = content?.intro?.trim();

// Destacados con al menos un titulo o descripcion no vacios; los vacios se
// descartan para no renderizar tarjetas huecas.
const items = Array.isArray(content?.items)
  ? content!.items!.filter(
      (item) => (item?.title?.trim() || item?.description?.trim())
    )
  : [];
const hasItems = items.length > 0;

// Columnas de la cuadricula segun la cantidad de destacados, para que la ultima
// fila cierre pareja: 4 items -> 4 columnas; 2 -> 2; el resto -> 3.
const gridCols: 2 | 3 | 4 =
  items.length === 4 ? 4 : items.length === 2 ? 2 : 3;
---

{hasItems && (
  <Section eyebrow={eyebrow} title={title} intro={intro}>
    {/* Columnas ajustadas a la cantidad de destacados: con `auto-fit` puro, 4
      * items se partian en 3 + 1 y dejaban un hueco al final de la fila. */}
    <Grid min="240px" cols={gridCols} gap="lg" class="ds-features">
      {items.map((item, i) => (
        /* El titulo NO se pasa por el prop `title` de Card: se renderiza aqui,
         * despues del indice, para que el orden de lectura (indice -> titulo ->
         * texto) surja del propio marcado. Ordenarlo por CSS exigiria alcanzar
         * el interior de Card desde fuera, que es justo lo que el sistema de
         * estilos con alcance evita. */
        <Card
          icon={item.icon?.trim() || undefined}
          featured={item.highlight === true}
          image={item.image?.trim() || undefined}
          imageAlt={item.imageAlt?.trim() ?? ""}
          class="ds-feature-card"
        >
          {/* Indice editorial: ordena la coleccion y da el aire de revista. */}
          <span class="ds-index ds-feature-idx">
            {String(i + 1).padStart(2, "0")}
          </span>
          {item.title?.trim() && (
            <h3 class="ds-feature-title">{item.title.trim()}</h3>
          )}
          {item.description?.trim() && (
            <p class="ds-feature-desc">{item.description.trim()}</p>
          )}
        </Card>
      ))}
    </Grid>
  </Section>
)}

<style>
  /* Indice sobre el titulo: el orden lo da el marcado, no `order`. */
  .ds-feature-idx {
    display: block;
    margin-bottom: var(--space-xs);
  }
  .ds-feature-title {
    margin-bottom: var(--space-sm);
    /* Titulos de tarjeta un paso por debajo del h3 global: en una fila de 4
     * columnas el h3 fluido se comia el alto util y forzaba saltos de linea. */
    font-size: clamp(1.15rem, 1.4vw, 1.35rem);
    line-height: 1.25;
    text-wrap: balance;
  }
  .ds-feature-desc {
    margin: 0;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: color-mix(in srgb, currentColor 72%, transparent);
  }
</style>
