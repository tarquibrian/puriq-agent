---
// UI_Component: Section (Req 3.2, 3.3, 4.1, 4.4).
//
// Provee el ritmo vertical entre secciones usando la Spacing_Scale y separa
// secciones consecutivas de forma consistente. Envuelve su contenido en un
// Container para respetar el ancho maximo. Todo deriva de variables CSS de
// Design_Tokens (Req 4.5); el contenido se recibe por slots/props conservando
// los estilos del sistema (Req 4.4).
//
// Direccion editorial/nature: cabecera con `eyebrow` (etiqueta reutilizando la
// utilidad global), titulo h2, `intro` (parrafo lead muted), alineacion
// configurable y una variante `dark` para bandas de enfasis estilo RiverSide.
import Container from "./Container.astro";
interface Props {
  /** Ancla para navegacion (`id` del elemento <section>). */
  id?: string;
  /** Etiqueta editorial opcional sobre el titulo (usa la utilidad global). */
  eyebrow?: string;
  /** Titulo opcional; se renderiza como <h2> con la Type_Scale. */
  title?: string;
  /** Parrafo lead opcional bajo el titulo (color muted, ancho limitado). */
  intro?: string;
  /** Token de ancho de contenedor interno. */
  size?: "sm" | "md" | "lg" | "xl";
  /** Variante de enfasis: default | muted (fondo sutil) | dark (banda oscura). */
  variant?: "default" | "muted" | "dark";
  /** Alineacion de la cabecera. */
  align?: "left" | "center";
  /** Clase(s) adicionales opcionales. */
  class?: string;
}
const {
  id,
  eyebrow,
  title,
  intro,
  size = "lg",
  variant = "default",
  align = "left",
  class: className,
} = Astro.props;
const hasHeader = Boolean(eyebrow || title || intro);
---
<section
  id={id}
  class:list={["ds-section", "reveal", className]}
  data-variant={variant}
  data-align={align}
>
  <Container size={size}>
    {hasHeader && (
      <header class="ds-section-header">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {title && <h2 class="ds-section-title">{title}</h2>}
        {intro && <p class="ds-section-intro">{intro}</p>}
      </header>
    )}
    <slot />
  </Container>
</section>

<style>
  /* Ritmo vertical generoso y fluido entre secciones (Req 3.2, 3.3). */
  .ds-section { padding-block: clamp(3rem, 8vw, 7rem); }

  /* Variante con fondo sutil derivado del texto de marca (~4%). Un hairline
   * superior muy tenue refuerza la separacion entre secciones consecutivas. */
  .ds-section[data-variant="muted"] {
    background: color-mix(in srgb, var(--color-text) 4%, var(--color-background));
    border-top: 1px solid color-mix(in srgb, var(--color-text) 7%, transparent);
  }

  /* Variante oscura: banda de enfasis. Usa los tokens `--emphasis-*` (definidos
   * en Base) para quedar oscura con texto claro en modo claro Y oscuro; antes
   * mezclaba primary/text, que en modo oscuro daban una banda clara. */
  .ds-section[data-variant="dark"] {
    background: var(--emphasis-bg);
    color: var(--emphasis-text);
  }
  .ds-section[data-variant="dark"] :global(h1),
  .ds-section[data-variant="dark"] :global(h2),
  .ds-section[data-variant="dark"] :global(h3) {
    color: var(--emphasis-text);
  }

  /* Cabecera de seccion: ritmo interno y alineacion configurable. */
  .ds-section-header { margin-bottom: var(--space-xl); }
  .ds-section[data-align="center"] .ds-section-header {
    text-align: center;
    margin-inline: auto;
  }

  .ds-section-title { margin-bottom: var(--space-md); }
  .ds-section-header .eyebrow { margin-bottom: var(--space-sm); }

  /* Parrafo lead: color muted y ancho de lectura comodo (~60ch). */
  .ds-section-intro {
    max-width: 60ch;
    margin: 0;
    color: color-mix(in srgb, currentColor 70%, transparent);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
  .ds-section[data-align="center"] .ds-section-intro { margin-inline: auto; }
</style>
