---
// Modulo CHATWEB: asistente que responde dudas del visitante sobre el destino.
//
// Dos MODOS de presentacion (prop `mode`, derivada de `chatweb.display`):
//   - "floating" (por defecto): un boton burbuja fijo en la esquina que abre un
//     panel de chat. Vive en el layout (Base.astro), asi que acompana al
//     visitante en TODAS las paginas, no solo en la portada.
//   - "section": una seccion mas de la portada, en el orden configurado.
// El marcado de la conversacion (registro, chips, formulario) es COMUN a ambos
// modos: lo aporta `ChatConversation.astro`. Aqui solo cambia el envoltorio.
//
// Dos CAMINOS de respuesta, resueltos en el cliente:
//   A) Por defecto (sin `apiEndpoint`): recuperacion 100% client-side sobre la
//      base de conocimiento publica `faq`. No hay red ni secretos.
//   B) Si `chatweb.apiEndpoint` esta definido: POST {question} a ese endpoint
//      (proxy RAG). El endpoint es el UNICO lugar donde vivirian credenciales;
//      el cliente nunca las ve.
import { siteConfig, faq } from "../../lib/data";
import Section from "../../design-system/ui/Section.astro";
import Card from "../../design-system/ui/Card.astro";
import ChatConversation from "./ChatConversation.astro";

interface Props {
  /** "floating" (widget global) | "section" (seccion de la portada). */
  mode?: "floating" | "section";
}
const { mode = "section" } = Astro.props as Props;

const persona = siteConfig.modules?.chatweb?.persona ?? "asistente turistico";
const apiEndpoint: string = siteConfig.modules?.chatweb?.apiEndpoint ?? "";
const hasKnowledge = Array.isArray(faq) && faq.length > 0;
// Primeras preguntas del Q&A publicado, como sugerencias pulsables. Salen del
// mismo `faq` que alimenta la recuperacion: una sugerencia SIEMPRE tiene
// respuesta. En el panel flotante caben menos, asi que se recortan a 3.
const maxSugerencias = mode === "floating" ? 3 : 4;
const sugerencias: string[] = hasKnowledge
  ? faq.map((e: any) => (e?.question ?? "").trim()).filter(Boolean).slice(0, maxSugerencias)
  : [];
// Datos que se pasan al script del cliente (solo Q&A publico + config no secreta).
const clientData = { persona, apiEndpoint, faq };

const conversationProps = { persona, hasKnowledge, apiEndpoint, sugerencias };
---
{mode === "floating" ? (
  /* Widget flotante: boton burbuja + panel plegable. `<details>` da el
     abrir/cerrar accesible por teclado y sin JS; el script solo mejora el foco
     y cierra con Escape. */
  <details class="chat-fab" id="chat-fab">
    <summary class="chat-fab-btn" aria-label={`Abrir asistente: ${persona}`}>
      {/* Icono de chat (abierto) y de cerrar (X); el CSS alterna cual se ve. */}
      <svg class="chat-fab-icon chat-fab-open" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 5h16v11H8l-4 4V5Z" />
        <path d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01" />
      </svg>
      <svg class="chat-fab-icon chat-fab-close" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </summary>

    <div class="chat-panel" role="dialog" aria-label={`Asistente: ${persona}`}>
      <div class="chat-panel-head">
        <span class="chat-panel-title">Asistente</span>
        <span class="chat-panel-sub">{persona}</span>
      </div>
      <ChatConversation {...conversationProps} />
      <small class="chat-note">Responde con la informacion oficial publicada del destino.</small>
    </div>
  </details>
) : (
  /* Seccion de la portada: contexto a la izquierda, conversacion a la derecha. */
  <Section id="chatweb" eyebrow="Pregúntanos" title="Asistente turístico">
    <div class="chat-layout">
      <aside class="chat-aside">
        <p class="chat-lead">
          Resuelve tus dudas al instante con la informacion oficial publicada del
          destino.
        </p>
      </aside>
      <Card class="chat-card">
        <ChatConversation {...conversationProps} />
        <small class="chat-note">Responde con la informacion oficial publicada del destino.</small>
      </Card>
    </div>
  </Section>
)}

<script define:vars={{ clientData }}>
  // === Configuracion inyectada desde el servidor (Q&A publico, sin secretos) ===
  const PERSONA = clientData.persona;
  const API_ENDPOINT = clientData.apiEndpoint;
  const FAQ = Array.isArray(clientData.faq) ? clientData.faq : [];

  const FALLBACK =
    "No tengo esa informacion todavia. Proba reformular la pregunta o consulta " +
    "los datos de contacto oficiales del destino.";
  // Umbral de similaridad (fraccion de tokens de la consulta cubiertos por el
  // match). Ajustable: 0.34 pide que ~1/3 de los tokens relevantes coincidan.
  const THRESHOLD = 0.34;

  const STOPWORDS = new Set([
    "el","la","los","las","un","una","unos","unas","de","del","al","a","en",
    "y","o","u","que","como","cual","cuales","es","son","por","para","con",
    "se","su","sus","mi","me","te","lo","le","les","este","esta","estos","estas",
    "hay","tengo","puedo","puede","donde","cuando","cuanto","cuanta","muy","mas",
  ]);

  // Normaliza texto: minusculas, sin acentos, tokens alfanumericos, sin
  // stopwords ni tokens muy cortos (<3 chars, salvo que sean numeros).
  function tokenize(text) {
    const clean = (text || "")
      .toLowerCase()
      .normalize("NFD")
      .replace(/[̀-ͯ]/g, "")
      .replace(/[^a-z0-9\s]/g, " ");
    const out = [];
    for (const tok of clean.split(/\s+/)) {
      if (!tok) continue;
      if (tok.length < 3 && !/^\d+$/.test(tok)) continue;
      if (STOPWORDS.has(tok)) continue;
      out.push(tok);
    }
    return out;
  }

  // Similaridad por solapamiento de tokens: fraccion de tokens de la consulta
  // presentes en el conjunto candidato (question + answer). Robusta a longitud.
  function overlapScore(queryTokens, candidateSet) {
    if (queryTokens.length === 0) return 0;
    let hits = 0;
    for (const t of queryTokens) if (candidateSet.has(t)) hits++;
    return hits / queryTokens.length;
  }

  // Precomputa los conjuntos de tokens de cada entrada del FAQ.
  const INDEX = FAQ.map((entry) => {
    const qTokens = tokenize(entry.question);
    const aTokens = tokenize(entry.answer);
    return { entry, set: new Set([...qTokens, ...aTokens]) };
  });

  // Recuperacion client-side: elige la mejor entrada por encima del umbral.
  function retrieveLocal(question) {
    const qTokens = tokenize(question);
    let best = null;
    let bestScore = 0;
    for (const item of INDEX) {
      const score = overlapScore(qTokens, item.set);
      if (score > bestScore) {
        bestScore = score;
        best = item.entry;
      }
    }
    if (best && bestScore >= THRESHOLD) return best.answer;
    return FALLBACK;
  }

  const log = document.getElementById("chat-log");
  const form = document.getElementById("chat-form");
  const input = document.getElementById("chat-input");

  // La apariencia de la burbuja vive ENTERA en el CSS (`.chat-msg`, `.chat-bot`,
  // `.chat-user`, declaradas como globales porque estos nodos se crean en
  // tiempo de ejecucion y no llevan el atributo de alcance de Astro).
  function appendMessage(text, who) {
    const div = document.createElement("div");
    div.className = "chat-msg chat-" + who;
    div.textContent = text;
    log.appendChild(div);
    log.scrollTop = log.scrollHeight;
    return div;
  }

  // Camino B: consulta al endpoint RAG remoto (Bedrock proxy). Solo se usa si
  // apiEndpoint esta configurado. El endpoint recibe {question} y responde
  // {answer}. Ninguna credencial vive en el cliente.
  async function retrieveRemote(question) {
    const res = await fetch(API_ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ question }),
    });
    if (!res.ok) throw new Error("respuesta no OK del endpoint: " + res.status);
    const data = await res.json();
    return (data && (data.answer || data.reply)) || FALLBACK;
  }

  if (form && input) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const question = input.value.trim();
      if (!question) return;
      appendMessage(question, "user");
      input.value = "";
      input.disabled = true;

      const pending = appendMessage("...", "bot");
      try {
        let answer;
        if (API_ENDPOINT) {
          answer = await retrieveRemote(question);
        } else {
          answer = retrieveLocal(question);
        }
        pending.textContent = answer;
      } catch (err) {
        // Ante un fallo del endpoint remoto, degradamos a la recuperacion local
        // (si hay conocimiento) o al fallback, sin exponer detalles del error.
        pending.textContent = INDEX.length ? retrieveLocal(question) : FALLBACK;
      } finally {
        input.disabled = false;
        input.focus();
      }
    });

    // Preguntas sugeridas: rellenan el campo y disparan el MISMO envio, en vez
    // de duplicar la logica de consulta. `requestSubmit` respeta el flujo normal
    // del formulario (a diferencia de `submit()`, que se salta el listener).
    document.querySelectorAll(".chat-chip").forEach((chip) => {
      chip.addEventListener("click", () => {
        input.value = chip.dataset.question || chip.textContent.trim();
        form.requestSubmit
          ? form.requestSubmit()
          : form.dispatchEvent(new Event("submit", { cancelable: true }));
      });
    });
  }

  // --- Mejoras del widget flotante (solo si existe el `<details>`) ---
  const fab = document.getElementById("chat-fab");
  if (fab) {
    // Al abrir, se enfoca el campo para escribir de inmediato.
    fab.addEventListener("toggle", () => {
      if (fab.open && input) input.focus();
    });
    // Escape cierra el panel, como espera cualquier dialogo.
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && fab.open) fab.open = false;
    });
    // Un CTA en otra parte de la pagina (p. ej. el boton del header) puede abrir
    // el asistente marcandose con `data-open-chat`.
    document.querySelectorAll("[data-open-chat]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        fab.open = true;
        if (input) input.focus();
      });
    });
  }
</script>

<style>
  /* Presentacion derivada de variables CSS de Design_Tokens (Req 9.1). */

  /* ==========================================================================
   * Modo SECCION (portada)
   * ======================================================================== */
  .chat-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: start;
  }
  @media (min-width: 768px) {
    .chat-layout { grid-template-columns: 1fr 1.15fr; gap: var(--space-2xl); }
  }
  .chat-lead {
    margin: 0 0 var(--space-lg);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: color-mix(in srgb, var(--color-text) 72%, var(--color-background));
    max-width: 46ch;
  }
  .chat-card { max-width: none; }

  /* ==========================================================================
   * Modo FLOTANTE (widget global)
   * ======================================================================== */
  .chat-fab {
    position: fixed;
    right: clamp(var(--space-md), 4vw, var(--space-xl));
    bottom: clamp(var(--space-md), 4vw, var(--space-xl));
    z-index: 100;
  }

  /* Boton burbuja: circulo de acento con sombra, sobre cualquier contenido. */
  .chat-fab-btn {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-left: auto;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-background);
    box-shadow: var(--shadow-lg);
    cursor: pointer;
    transition:
      transform var(--motion-duration-fast) var(--motion-easing),
      background var(--motion-duration-base) var(--motion-easing);
  }
  .chat-fab-btn:hover { transform: translateY(-2px); }
  .chat-fab-btn::-webkit-details-marker { display: none; }
  .chat-fab-btn:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* El icono de cerrar solo se muestra con el panel abierto, y viceversa. */
  .chat-fab-close { display: none; }
  .chat-fab[open] .chat-fab-open { display: none; }
  .chat-fab[open] .chat-fab-close { display: block; }

  /* Panel de conversacion sobre el boton. Ancho comodo en desktop; a sangre
   * (casi pantalla completa) en movil, donde un panelito seria incomodo. */
  .chat-panel {
    position: absolute;
    right: 0;
    bottom: calc(3.5rem + var(--space-md));
    width: min(23rem, calc(100vw - 2 * var(--space-md)));
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--color-background);
    color: var(--color-text);
    border: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    /* Animacion de entrada; el estado cerrado no renderiza el panel (details). */
    transform-origin: bottom right;
    animation: chat-panel-in var(--motion-duration-base) var(--motion-easing);
  }
  @keyframes chat-panel-in {
    from { opacity: 0; transform: translateY(8px) scale(.98); }
    to { opacity: 1; transform: none; }
  }

  .chat-panel-head {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
  }
  .chat-panel-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: 1.1;
  }
  .chat-panel-sub {
    font-size: var(--fs-small);
    color: color-mix(in srgb, var(--color-text) 60%, var(--color-background));
  }

  @media (max-width: 480px) {
    /* En movil el panel ocupa casi todo el ancho y se ancla a los bordes. */
    .chat-fab { left: var(--space-md); right: var(--space-md); }
    .chat-panel {
      width: auto;
      left: 0;
      right: 0;
      max-height: 70vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-fab-btn { transition: none; }
    .chat-fab-btn:hover { transform: none; }
    .chat-panel { animation: none; }
  }

  /* Nota al pie de la conversacion (la renderiza este componente en ambos
   * modos, por eso su estilo vive aca y no en ChatConversation). */
  .chat-note {
    display: block;
    color: color-mix(in srgb, var(--color-text) 55%, var(--color-background));
  }
</style>
