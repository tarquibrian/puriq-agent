# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo.

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu-access-key
AWS_SECRET_ACCESS_KEY=tu-secret-key

# --- LLM (Amazon Bedrock) ---
# Requiere acceso al modelo aprobado en la consola de Bedrock.
PURIQ_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0

# Motor del LLM: bedrock (nube AWS) | openai (OpenAI/Azure) | local (Ollama)
#
# El chat conversacional del wizard necesita tool-use, asi que solo funciona con
# `bedrock` u `openai`; el modo `local` es text-only (sirve para enriquecer
# contenido, no para conversar). Por MCP no hace falta ninguno: el modelo lo
# pone el cliente.
PURIQ_LLM_MODE=bedrock

# --- LLM (OpenAI o Azure OpenAI), solo si PURIQ_LLM_MODE=openai ---
# Si la base_url contiene `azure.com` se usa el estilo Azure automaticamente
# (cabecera `api-key` y ruta /openai/deployments/<modelo>/chat/completions).
PURIQ_OPENAI_API_KEY=tu-api-key
# OpenAI: https://api.openai.com/v1 (default)
# Azure:  https://<tu-recurso>.openai.azure.com
PURIQ_OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI: nombre del modelo. Azure: nombre del *deployment*.
PURIQ_OPENAI_MODEL=gpt-4o
# Solo Azure: version de la API.
PURIQ_OPENAI_API_VERSION=2024-10-21

# --- RAG del chatbot (opcional en MVP) ---
# Modelo de embeddings de Bedrock (Titan) para indexar los Q&A.
PURIQ_EMBED_MODEL=amazon.titan-embed-text-v2:0

# --- Deploy (opcional) ---
# Destino por defecto: aws-amplify | s3-cloudfront | static-export | vercel | netlify
PURIQ_DEPLOY_TARGET=aws-amplify

# Deploy destino aws-amplify:
PURIQ_AMPLIFY_APP_ID=tu-amplify-app-id
PURIQ_AMPLIFY_BRANCH=main

# Deploy destino s3-cloudfront:
PURIQ_S3_BUCKET=tu-bucket-s3
PURIQ_CLOUDFRONT_DISTRIBUTION_ID=tu-distribution-id
# Dominio publico (opcional; si falta se deriva del DomainName de CloudFront)
PURIQ_SITE_DOMAIN=turismo.ejemplo.gob
