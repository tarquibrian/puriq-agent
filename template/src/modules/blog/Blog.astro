---
// Modulo BLOG: noticias/articulos desde markdown (Content Collection `blog`).
// Los Articles los inyecta el build (build_site._inject_articles) copiando
// <project>/content/*.md a src/content/blog/. Aqui se leen con getCollection,
// se ordenan por fecha descendente y se renderiza el cuerpo markdown real.
// TODO(v2): panel admin con roles editor/admin. Ver PROYECTO seccion 7 (roadmap).
//
// Uplift de presentacion (DD-7, Req 9): el marcado usa los UI_Component
// `Section`, `Grid` y `Card` y variables CSS de Design_Tokens. Si el articulo
// trae imagen en su frontmatter se pasa por el prop `image` de Card. La lectura
// de la Content Collection, el orden por fecha descendente, el render del
// markdown `Content` y el estado vacio se conservan intactos (Req 9.4, 16.3).
import { getCollection } from "astro:content";
import Section from "../../design-system/ui/Section.astro";
import Grid from "../../design-system/ui/Grid.astro";
import Card from "../../design-system/ui/Card.astro";
import { assetExists } from "../../design-system/assets";

const entries = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Pre-render del cuerpo markdown de cada Article (Astro compila el markdown).
const posts = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await entry.render();
    return { data: entry.data, Content };
  })
);

/**
 * Fecha del articulo en texto legible.
 *
 * Se formatea en UTC a proposito. El `date` del frontmatter es una fecha SIN
 * hora (`YYYY-MM-DD`) que `z.coerce.date()` convierte a medianoche UTC; al
 * formatearla en la hora local del build, cualquier huso al oeste de Greenwich
 * —toda America Latina— mostraba el dia anterior al escrito por el autor.
 * Fijando `timeZone: "UTC"` se muestra la fecha tal como se cargo, y ademas el
 * build deja de depender del huso de la maquina que lo corre.
 */
const fmt = (d: Date) =>
  new Date(d).toLocaleDateString("es", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
---
{/* El `id` del anchor lo porta esta Section (el Home ya no la envuelve). */}
<Section id="blog" eyebrow="Al día" title="Noticias">
  {posts.length === 0 ? (
    <p class="blog-empty">Aún no hay artículos publicados.</p>
  ) : (
    <Grid min="340px" cols={posts.length === 2 ? 2 : 3} gap="lg">
      {posts.map((post, i) => {
        const Content = post.Content;
        // Imagen opcional del frontmatter (se pasa al recorte de la Card).
        // Solo se usa si el archivo existe: una portada colgante dejaba un
        // hueco roto arriba de la tarjeta.
        const declarada = (post.data as any).image as string | undefined;
        const image = assetExists(declarada) ? declarada : undefined;
        return (
          <Card class="blog-card" image={image} imageAlt={post.data.title}>
            <div class="blog-meta">
              <span class="ds-index">{String(i + 1).padStart(2, "0")}</span>
              <time class="blog-date" datetime={post.data.date.toISOString().slice(0, 10)}>{fmt(post.data.date)}</time>
            </div>
            <h3 class="blog-title">{post.data.title}</h3>
            {post.data.summary && (
              <p class="blog-summary">{post.data.summary}</p>
            )}
            <div class="blog-body"><Content /></div>
          </Card>
        );
      })}
    </Grid>
  )}
</Section>

<style>
  /* Apariencia derivada de variables CSS de Design_Tokens (Req 9.1). */

  /* Indice + fecha en una linea, como cabecera de la ficha. */
  .blog-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }
  .blog-empty {
    color: color-mix(in srgb, var(--color-text) 60%, var(--color-background));
  }
  /* Fecha como kicker de acento, coherente con el modulo de eventos. */
  .blog-date {
    color: var(--color-accent);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .blog-title { margin: 0 0 var(--space-sm); }
  .blog-summary {
    font-style: italic;
    color: color-mix(in srgb, var(--color-text) 75%, var(--color-background));
  }
  .blog-body { color: var(--color-text); }
</style>
