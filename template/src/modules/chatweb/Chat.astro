---
// Modulo CHATWEB: asistente que responde dudas del visitante sobre el destino.
//
// Dos caminos, resueltos en runtime en el cliente:
//   A) Por defecto (sin `apiEndpoint`): recuperacion 100% client-side sobre la
//      base de conocimiento publica `faq` (inyectada en build desde content/).
//      No hay red ni secretos: solo se usa el Q&A publico embebido.
//   B) Seam a futuro: si `siteConfig.modules.chatweb.apiEndpoint` esta definido,
//      el widget hace POST {question} a ese endpoint (proxy RAG de Bedrock que
//      se agregara en el dia 4) y renderiza la respuesta devuelta. El endpoint
//      es el UNICO lugar donde vivirian credenciales; el cliente nunca las ve.
//
// Uplift de presentacion (DD-7, Req 9): el marcado usa los UI_Component
// `Section`, `Card` y `Button` y variables CSS de Design_Tokens. Los mensajes
// se presentan como burbujas comodas y el formulario con campos redondeados. La
// logica de recuperacion client-side, el `faq` de entrada, el comportamiento de
// `apiEndpoint` y los `id` del DOM (`chat-log`, `chat-form`, `chat-input`) y el
// campo `name="question"` se conservan intactos (Req 9.4, 16.3).
import { siteConfig, faq } from "../../lib/data";
import Section from "../../design-system/ui/Section.astro";
import Card from "../../design-system/ui/Card.astro";
import Button from "../../design-system/ui/Button.astro";
const persona = siteConfig.modules?.chatweb?.persona ?? "asistente turistico";
const apiEndpoint: string = siteConfig.modules?.chatweb?.apiEndpoint ?? "";
const hasKnowledge = Array.isArray(faq) && faq.length > 0;
// Datos que se pasan al script del cliente (solo Q&A publico + config no secreta).
const clientData = { persona, apiEndpoint, faq };
---
{/* El `id` del anchor lo porta esta Section (el Home ya no la envuelve). */}
<Section id="chatweb" eyebrow="Pregúntanos" title="Asistente turístico">
  <Card class="chat-card">
    <div id="chat-log" class="chat-log">
      <div class="chat-msg chat-bot">
        Hola, soy tu {persona}. Preguntame sobre lugares, eventos y como llegar.
      </div>
      {!hasKnowledge && !apiEndpoint && (
        <div class="chat-msg chat-bot chat-muted">
          Todavia no tengo informacion cargada. Volve a consultarme cuando el sitio
          tenga sus preguntas frecuentes publicadas.
        </div>
      )}
    </div>
    <form id="chat-form" class="chat-form">
      <input
        id="chat-input"
        class="chat-input"
        name="question"
        autocomplete="off"
        placeholder="Escribi tu pregunta..."
      />
      <Button type="submit">Enviar</Button>
    </form>
    <small class="chat-note">Responde con la informacion oficial publicada del destino.</small>
  </Card>
</Section>

<script define:vars={{ clientData }}>
  // === Configuracion inyectada desde el servidor (Q&A publico, sin secretos) ===
  const PERSONA = clientData.persona;
  const API_ENDPOINT = clientData.apiEndpoint;
  const FAQ = Array.isArray(clientData.faq) ? clientData.faq : [];

  const FALLBACK =
    "No tengo esa informacion todavia. Proba reformular la pregunta o consulta " +
    "los datos de contacto oficiales del destino.";
  // Umbral de similaridad (fraccion de tokens de la consulta cubiertos por el
  // match). Ajustable: 0.34 pide que ~1/3 de los tokens relevantes coincidan.
  const THRESHOLD = 0.34;

  const STOPWORDS = new Set([
    "el","la","los","las","un","una","unos","unas","de","del","al","a","en",
    "y","o","u","que","como","cual","cuales","es","son","por","para","con",
    "se","su","sus","mi","me","te","lo","le","les","este","esta","estos","estas",
    "hay","tengo","puedo","puede","donde","cuando","cuanto","cuanta","muy","mas",
  ]);

  // Normaliza texto: minusculas, sin acentos, tokens alfanumericos, sin
  // stopwords ni tokens muy cortos (<3 chars, salvo que sean numeros).
  function tokenize(text) {
    const clean = (text || "")
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9\s]/g, " ");
    const out = [];
    for (const tok of clean.split(/\s+/)) {
      if (!tok) continue;
      if (tok.length < 3 && !/^\d+$/.test(tok)) continue;
      if (STOPWORDS.has(tok)) continue;
      out.push(tok);
    }
    return out;
  }

  // Similaridad por solapamiento de tokens: fraccion de tokens de la consulta
  // presentes en el conjunto candidato (question + answer). Robusta a longitud.
  function overlapScore(queryTokens, candidateSet) {
    if (queryTokens.length === 0) return 0;
    let hits = 0;
    for (const t of queryTokens) if (candidateSet.has(t)) hits++;
    return hits / queryTokens.length;
  }

  // Precomputa los conjuntos de tokens de cada entrada del FAQ.
  const INDEX = FAQ.map((entry) => {
    const qTokens = tokenize(entry.question);
    const aTokens = tokenize(entry.answer);
    return { entry, set: new Set([...qTokens, ...aTokens]) };
  });

  // Recuperacion client-side: elige la mejor entrada por encima del umbral.
  function retrieveLocal(question) {
    const qTokens = tokenize(question);
    let best = null;
    let bestScore = 0;
    for (const item of INDEX) {
      const score = overlapScore(qTokens, item.set);
      if (score > bestScore) {
        bestScore = score;
        best = item.entry;
      }
    }
    if (best && bestScore >= THRESHOLD) return best.answer;
    return FALLBACK;
  }

  const log = document.getElementById("chat-log");
  const form = document.getElementById("chat-form");
  const input = document.getElementById("chat-input");

  function appendMessage(text, who) {
    const div = document.createElement("div");
    div.className = "chat-msg chat-" + who;
    div.textContent = text;
    div.style.alignSelf = who === "user" ? "flex-end" : "flex-start";
    if (who === "user") {
      // Estilo del mensaje del usuario derivado de tokens de marca (Req 9.1).
      div.style.background = "var(--color-primary)";
      div.style.color = "var(--color-background)";
      div.style.padding = "var(--space-xs) var(--space-sm)";
      div.style.borderRadius = "var(--radius-md)";
    }
    log.appendChild(div);
    log.scrollTop = log.scrollHeight;
    return div;
  }

  // Camino B: consulta al endpoint RAG remoto (Bedrock proxy). Solo se usa si
  // apiEndpoint esta configurado. El endpoint recibe {question} y responde
  // {answer}. Ninguna credencial vive en el cliente.
  async function retrieveRemote(question) {
    const res = await fetch(API_ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ question }),
    });
    if (!res.ok) throw new Error("respuesta no OK del endpoint: " + res.status);
    const data = await res.json();
    return (data && (data.answer || data.reply)) || FALLBACK;
  }

  if (form && input) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const question = input.value.trim();
      if (!question) return;
      appendMessage(question, "user");
      input.value = "";
      input.disabled = true;

      const pending = appendMessage("...", "bot");
      try {
        let answer;
        if (API_ENDPOINT) {
          answer = await retrieveRemote(question);
        } else {
          answer = retrieveLocal(question);
        }
        pending.textContent = answer;
      } catch (err) {
        // Ante un fallo del endpoint remoto, degradamos a la recuperacion local
        // (si hay conocimiento) o al fallback, sin exponer detalles del error.
        pending.textContent = INDEX.length ? retrieveLocal(question) : FALLBACK;
      } finally {
        input.disabled = false;
        input.focus();
      }
    });
  }
</script>

<style>
  /* Presentacion derivada de variables CSS de Design_Tokens (Req 9.1). */
  .chat-card { max-width: var(--container-sm); }
  .chat-log {
    min-height: 5rem;
    /* Alto comodo con desplazamiento cuando la conversacion crece. */
    max-height: clamp(16rem, 40vh, 26rem);
    overflow-y: auto;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    color: var(--color-text);
  }
  /* Burbujas comodas: relleno generoso y radio grande (esquina inferior
   * "hablante" mas ajustada para dar direccion a cada mensaje). */
  .chat-msg {
    align-self: flex-start;
    max-width: 85%;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-lg);
  }
  /* Burbuja del asistente: superficie sutil derivada del texto de marca. */
  .chat-bot {
    background: color-mix(in srgb, var(--color-text) 6%, var(--color-background));
    border-bottom-left-radius: var(--radius-sm);
  }
  .chat-muted {
    color: color-mix(in srgb, var(--color-text) 55%, var(--color-background));
  }
  .chat-form {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
  .chat-input {
    flex: 1;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid color-mix(in srgb, var(--color-text) 25%, var(--color-background));
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    background: var(--color-background);
    color: var(--color-text);
    transition: border-color var(--motion-duration-base) var(--motion-easing);
  }
  .chat-input:focus-visible {
    outline: none;
    border-color: var(--color-accent);
  }
  .chat-note {
    display: block;
    margin-top: var(--space-sm);
    color: color-mix(in srgb, var(--color-text) 55%, var(--color-background));
  }
</style>
