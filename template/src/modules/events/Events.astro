---
// Modulo EVENTS: calendario turistico con fechas clave.
//
// Uplift de presentacion (DD-7, Req 9): el marcado usa el UI_Component `Section`
// y variables CSS de Design_Tokens. Los datos (`events`) y su orden funcional
// (ascendente por `startDate`) se conservan intactos (Req 9.4, 16.3).
//
// Direccion editorial: AGENDA en filas, no cuadricula de tarjetas. Dos razones:
//
//  1. Una agenda se lee en vertical, recorriendo fechas; una cuadricula obliga a
//     saltar en zigzag y pierde el orden cronologico que el modulo ya garantiza.
//  2. Ritmo de pagina: Lugares ya es una cuadricula de tarjetas. Repetir el mismo
//     patron aca aplanaba la lectura; alternar formato es lo que hace que una
//     landing larga no se sienta monotona.
//
// Cada fila lleva un bloque de fecha tipo calendario (dia grande + mes) en vez
// de la fecha como texto corrido, que es como se lee una cartelera real.
import { events, places } from "../../lib/data";
import Section from "../../design-system/ui/Section.astro";
import Icon from "../../design-system/ui/Icon.astro";

const sorted = [...events].sort((a, b) => a.startDate.localeCompare(b.startDate));

/**
 * Fecha completa legible.
 *
 * Se construye con `new Date(y, m-1, d)` (constructor por PARTES, hora local) y
 * no con `new Date("2026-02-14")`. El constructor con un string ISO sin hora lo
 * interpreta como UTC, asi que al formatearlo en hora local el dia se corria uno
 * hacia atras en todo huso al oeste de Greenwich: un evento del 14 de febrero se
 * anunciaba el 13. Se veia en el sitio construido antes de este cambio.
 */
function fmt(iso: string): string {
  const [y, m, d] = (iso || "").split("-").map(Number);
  if (!y || !m || !d) return iso ?? "";
  return new Date(y, m - 1, d).toLocaleDateString("es", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

/**
 * Partes del bloque de calendario. Se construye desde el string ISO
 * `YYYY-MM-DD` en vez de `new Date(...).getDate()`: el constructor interpreta
 * una fecha sin hora como UTC y, en husos al oeste de Greenwich —toda America
 * Latina—, el dia mostrado se corria uno hacia atras.
 */
function dateParts(iso: string): { day: string; month: string; year: string } {
  const [y, m, d] = (iso || "").split("-");
  const meses = ["ene", "feb", "mar", "abr", "may", "jun",
                 "jul", "ago", "sep", "oct", "nov", "dic"];
  return {
    day: d ?? "",
    month: meses[Number(m) - 1] ?? "",
    year: y ?? "",
  };
}

/** Nombre del lugar asociado; el `placeId` es un slug que no le dice nada al visitante. */
const placeName = (id?: string) =>
  id ? (places.find((p: any) => p.id === id)?.name ?? null) : null;

/** Rango de fechas en texto, solo cuando el evento dura mas de un dia. */
function rango(e: any): string | null {
  if (!e.endDate || e.endDate === e.startDate) return null;
  return `Hasta el ${fmt(e.endDate)}`;
}
---
{/* El `id` del anchor lo porta esta Section (el Home ya no la envuelve). */}
<Section id="events" eyebrow="Agenda" title="Eventos y fechas clave">
  <ol class="agenda">
    {sorted.map((e, i) => {
      const { day, month, year } = dateParts(e.startDate);
      const lugar = placeName(e.placeId);
      const hasta = rango(e);
      return (
        <li class="agenda-item">
          {/* Bloque de calendario: dia grande + mes, como una cartelera. */}
          <time class="agenda-date" datetime={e.startDate}>
            <span class="agenda-day">{day}</span>
            <span class="agenda-month">{month}</span>
            <span class="agenda-year">{year}</span>
          </time>

          <div class="agenda-body">
            <span class="ds-index agenda-idx">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="agenda-name">{e.name}</h3>
            {e.description && <p class="agenda-desc">{e.description}</p>}

            {/* Meta: solo se renderiza lo que el contrato realmente trae. */}
            {(lugar || hasta || e.recurring) && (
              <ul class="agenda-meta">
                {lugar && (
                  <li><Icon name="map-pin" size="1em" /><span>{lugar}</span></li>
                )}
                {hasta && (
                  <li><Icon name="calendar" size="1em" /><span>{hasta}</span></li>
                )}
                {e.recurring && (
                  <li><Icon name="clock" size="1em" /><span>{e.recurring}</span></li>
                )}
              </ul>
            )}
          </div>
        </li>
      );
    })}
  </ol>
</Section>

<style>
  /* Toda la apariencia deriva de variables CSS de Design_Tokens (Req 9.1). */

  .agenda {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
  }

  /* Fila de agenda: bloque de fecha + contenido. Mobile-first en una columna. */
  .agenda-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-lg);
    align-items: start;
    padding-block: var(--space-lg);
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
    transition: background var(--motion-duration-base) var(--motion-easing);
  }
  .agenda-item:hover {
    background: color-mix(in srgb, var(--color-accent) 4%, transparent);
  }

  /* Bloque de calendario: superficie tenue de marca, cifras tabulares. */
  .agenda-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 4.75rem;
    padding: var(--space-sm);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-primary) 8%, var(--color-background));
    border: 1px solid color-mix(in srgb, var(--color-primary) 16%, transparent);
    color: var(--color-primary);
    line-height: 1;
    text-align: center;
  }
  .agenda-day {
    font-family: var(--font-heading);
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .agenda-month {
    margin-top: 0.2em;
    font-size: var(--fs-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .agenda-year {
    margin-top: 0.25em;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--color-primary) 62%, transparent);
  }

  .agenda-body { min-width: 0; }
  .agenda-idx { display: block; margin-bottom: var(--space-xs); }
  .agenda-name { margin: 0 0 var(--space-sm); }

  .agenda-desc {
    margin: 0 0 var(--space-sm);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: color-mix(in srgb, var(--color-text) 72%, var(--color-background));
    max-width: 62ch;
  }

  /* Meta en linea: se pliega a varias lineas en pantallas estrechas. */
  .agenda-meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    font-size: var(--fs-small);
    color: color-mix(in srgb, var(--color-text) 62%, var(--color-background));
  }
  .agenda-meta li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-width: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .agenda-item { transition: none; }
  }
</style>
