---
// Landing_Section: Stats / Metricas (Req 12.4).
//
// Renderiza cada metrica de `content.metrics[]` con su valor y su etiqueta,
// dispuestas en una cuadricula responsive. Reutiliza los UI_Component `Section`
// y `Grid`; toda la apariencia deriva de variables CSS de Design_Tokens.
//
// Render defensivo (Req 12.5): si no hay metricas con contenido, la seccion se
// omite por completo (no se renderiza nada).
import Section from "../ui/Section.astro";
import Grid from "../ui/Grid.astro";

interface StatMetric {
  value?: string;
  label?: string;
}
interface StatsContent {
  title?: string;
  metrics?: StatMetric[];
}
interface Props {
  content?: StatsContent;
}

const { content } = Astro.props;

const title = content?.title?.trim();

// Metricas con al menos un valor o etiqueta no vacios.
const metrics = Array.isArray(content?.metrics)
  ? content!.metrics!.filter(
      (metric) => (metric?.value?.trim() || metric?.label?.trim())
    )
  : [];
const hasMetrics = metrics.length > 0;
---

{hasMetrics && (
  <Section title={title} variant="muted">
    <Grid min="180px" gap="lg">
      {metrics.map((metric) => (
        <div class="ds-stat">
          {metric.value?.trim() && (
            <span class="ds-stat-value">{metric.value.trim()}</span>
          )}
          {metric.label?.trim() && (
            <span class="ds-stat-label">{metric.label.trim()}</span>
          )}
        </div>
      ))}
    </Grid>
  </Section>
)}

<style>
  .ds-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-xs);
  }
  .ds-stat-value {
    font-family: var(--font-heading), Georgia, serif;
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    color: var(--color-primary);
    font-weight: 700;
  }
  .ds-stat-label {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--color-text);
  }
</style>
