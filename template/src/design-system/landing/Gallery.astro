---
// Landing_Section: Gallery / Galeria (Req 12.3, 8.4, 5.5).
//
// Direccion editorial/nature: mosaico tipo revista en vez de una cuadricula
// uniforme. La PRIMERA imagen ocupa dos columnas y dos filas (pieza destacada) y
// el resto rellena el mosaico; todas con esquinas redondeadas (var(--radius-lg)),
// object-fit cover, zoom sutil en hover y su texto alternativo (Req 8.4). El
// mosaico es responsive y colapsa a 1-2 columnas en movil sin desbordar
// (Req 5.5). Cabecera opcional con `eyebrow`/`title` via UI_Component `Section`.
//
// Render defensivo (Req 12.5): si no hay imagenes con `src`, la seccion se omite
// por completo (no se renderiza nada).
import Section from "../ui/Section.astro";
import { assetExists, assetUrl } from "../assets";

interface GalleryImage {
  src?: string;
  alt?: string;
}
interface GalleryContent {
  /** Etiqueta editorial opcional sobre el titulo (kicker). */
  eyebrow?: string;
  title?: string;
  images?: GalleryImage[];
}
interface Props {
  content?: GalleryContent;
}

const { content } = Astro.props;

const eyebrow = content?.eyebrow?.trim();
const title = content?.title?.trim();

// Solo imagenes con `src`; el `alt` cae a cadena vacia (imagen decorativa) si
// no se proporciona, garantizando que el atributo siempre este presente.
const images = Array.isArray(content?.images)
  ? content!.images!
      .filter((img) => img?.src?.trim())
      .map((img) => ({ src: img.src!.trim(), alt: img.alt?.trim() ?? "" }))
      // Una referencia colgante pintaba un hueco roto dentro del mosaico; se
      // descarta para que el mosaico se recomponga con las imagenes que si estan.
      .filter((img) => assetExists(img.src))
  : [];
const hasImages = images.length > 0;
---

{hasImages && (
  <Section eyebrow={eyebrow} title={title}>
    {/* El patron del mosaico depende de la CANTIDAD de imagenes: la pieza
      * destacada 2x2 solo cierra pareja con 3 o 5+ imagenes. Con 4, esa misma
      * regla dejaba la ultima sola en una fila nueva y un hueco grande a su
      * derecha, asi que 4 se dispone como cuadricula 2x2 uniforme. */}
    <div class="ds-mosaic" data-count={images.length}>
      {images.map((img, i) => (
        <figure class:list={["ds-mosaic-item", i === 0 && "is-feature"]}>
          <img src={assetUrl(img.src)} alt={img.alt} loading="lazy" decoding="async" />
          {/* Leyenda sobre la imagen: indice numerado + texto alternativo como
            * pie. Solo aparece cuando la imagen trae `alt` con contenido (una
            * imagen decorativa no debe arrastrar un pie vacio). */}
          {img.alt && (
            <figcaption class="ds-mosaic-caption">
              <span class="ds-index">{String(i + 1).padStart(2, "0")}</span>
              <span class="ds-mosaic-alt">{img.alt}</span>
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  </Section>
)}

<style>
  /* Mosaico editorial: la pieza destacada abarca dos columnas/filas y el resto
   * rellena el flujo. Mobile-first: una sola columna que no desborda (Req 5.5). */
  .ds-mosaic {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: 1fr;
    gap: var(--space-md);
  }
  .ds-mosaic-item {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  /* Pie numerado sobre un velo inferior: mantiene legible el texto sobre
   * cualquier foto sin oscurecer la imagen entera. El velo se deriva del color
   * de texto de marca, no de un negro fijo. */
  .ds-mosaic-caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    padding: var(--space-lg) var(--space-md) var(--space-md);
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-text) 78%, transparent),
      transparent
    );
    color: var(--color-background);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    /* No intercepta el hover/zoom de la imagen. */
    pointer-events: none;
  }
  /* El indice hereda `currentColor` (claro) en vez del mix tenue por defecto. */
  .ds-mosaic-caption .ds-index {
    color: color-mix(in srgb, var(--color-background) 75%, transparent);
    flex: none;
  }
  .ds-mosaic-alt {
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ds-mosaic-item img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
    transition: transform var(--motion-duration-base) var(--motion-easing);
  }
  .ds-mosaic-item:hover img { transform: scale(1.05); }

  /* Dos columnas desde tablet; la pieza destacada ocupa las dos. */
  @media (min-width: 600px) {
    .ds-mosaic { grid-template-columns: repeat(2, 1fr); }
    .ds-mosaic-item.is-feature { grid-column: span 2; }
  }

  /* Mosaico completo en desktop: tres columnas y la destacada 2x2. */
  @media (min-width: 900px) {
    .ds-mosaic {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 220px;
    }
    .ds-mosaic-item.is-feature {
      grid-column: span 2;
      grid-row: span 2;
    }
    .ds-mosaic-item img { aspect-ratio: auto; }

    /* 4 imagenes: cuadricula 2x2 pareja. Con la destacada 2x2 sobre 3 columnas,
     * la cuarta imagen caia sola en una tercera fila. */
    .ds-mosaic[data-count="4"] {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 260px;
    }
    .ds-mosaic[data-count="4"] .ds-mosaic-item.is-feature {
      grid-column: span 1;
      grid-row: span 1;
    }

    /* 2 imagenes: una al lado de la otra, sin destacada. */
    .ds-mosaic[data-count="2"] {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 320px;
    }
    .ds-mosaic[data-count="2"] .ds-mosaic-item.is-feature {
      grid-column: span 1;
      grid-row: span 1;
    }

    /* 1 imagen: pieza unica a todo el ancho. */
    .ds-mosaic[data-count="1"] {
      grid-template-columns: 1fr;
      grid-auto-rows: 420px;
    }
    .ds-mosaic[data-count="1"] .ds-mosaic-item.is-feature {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

  /* Reduced_Motion: sin zoom en hover (Req 6.2). */
  @media (prefers-reduced-motion: reduce) {
    .ds-mosaic-item img { transition: none; }
    .ds-mosaic-item:hover img { transform: none; }
  }
</style>
