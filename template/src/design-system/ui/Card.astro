---
// UI_Component: Card (Req 4.3, 4.4, 4.5).
//
// Aplica radio, sombra y relleno de Design_Tokens. Cuando recibe `href` se
// vuelve una tarjeta enlazable. El estilo de borde/sombra se lee de los ganchos
// de Layout_Variant (--card-border / --card-shadow, definidos por DD-4 en
// Base.astro) con un fallback a tokens, de modo que la tarjeta luce distinta en
// `clasico` (borde fino) y `moderno` (sombra elevada) sin fijar marca (Req 7.3).
// El contenido se recibe por slots/props conservando los estilos del sistema.
//
// Direccion editorial/nature: superficie suave PRESENTE (borde sutil + sombra
// en reposo), elevacion generosa en hover y area de medios opcional (`image`)
// que recorta la imagen arriba con zoom en hover para un acabado tipo revista.
// Ademas admite un `icon` (chip con tinte de acento sobre el titulo) y un modo
// `featured` para destacar una tarjeta como la protagonista.
import Icon from "./Icon.astro";
interface Props {
  /** Titulo opcional (Req 4.4). */
  title?: string;
  /** Destino del enlace; convierte la tarjeta en <a>. */
  href?: string;
  /** Imagen opcional; se renderiza como area de medios recortada arriba. */
  image?: string;
  /** Texto alternativo de la imagen (accesibilidad). */
  imageAlt?: string;
  /** Icono opcional; renderiza un chip de acento sobre el titulo. */
  icon?: string;
  /** Marca la tarjeta como destacada (borde + tinte de acento). */
  featured?: boolean;
  /** Clase(s) adicionales opcionales. */
  class?: string;
}
const {
  title,
  href,
  image,
  imageAlt = "",
  icon,
  featured = false,
  class: className,
} = Astro.props;
const Tag = href ? "a" : "article";
---
<Tag
  class:list={[
    "ds-card",
    image && "has-media",
    featured && "is-featured",
    className,
  ]}
  href={href}
>
  {image && (
    <div class="ds-card-media">
      <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
    </div>
  )}
  <div class="ds-card-body">
    {icon && (
      <span class="ds-card-icon-chip" aria-hidden="true">
        <Icon name={icon} />
      </span>
    )}
    {title && <h3 class="ds-card-title">{title}</h3>}
    <slot />
    {href && <span class="ds-card-arrow" aria-hidden="true">&rarr;</span>}
  </div>
</Tag>

<style>
  .ds-card {
    display: block;
    background: var(--color-background);
    color: var(--color-text);
    /* Color para las decoraciones "de acento" que viven DENTRO de la tarjeta
     * (comillas, chips, iconos) y que aportan los componentes que la usan.
     *
     * Existe porque los estilos con alcance no permiten que un componente
     * padre estilice la raiz de un hijo: al pasar `class` a la Card, la raiz
     * conserva el identificador de alcance de Card, no el del padre. Una
     * variable CSS si atraviesa esa frontera, porque hereda por el DOM. Asi la
     * tarjeta declara "de que color se pinta el acento aca adentro" y cada
     * seccion la consume sin conocer el estado interno de la Card. */
    --card-accent: var(--color-accent);
    border-radius: var(--card-radius, var(--radius-lg));
    /* Superficie mas presente en reposo: borde sutil pero visible + sombra
     * media, con ganchos de Layout_Variant que pueden sobreescribir (Req 7.3). */
    border: var(--card-border, 1px solid color-mix(in srgb, var(--color-text) 8%, transparent));
    box-shadow: var(--card-shadow, var(--shadow-md));
    text-decoration: none;
    overflow: hidden;
    transition:
      transform var(--motion-duration-base) var(--motion-easing),
      box-shadow var(--motion-duration-base) var(--motion-easing);
  }

  .ds-card-body { padding: var(--space-lg); }

  /* Chip de icono: cuadrado redondeado con tinte de acento y glifo de acento. */
  .ds-card-icon-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--space-md);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-accent) 14%, var(--color-background));
    color: var(--color-accent);
    font-size: 1.35rem;
    line-height: 1;
  }

  /* Tarjeta destacada: superficie SOLIDA de acento con texto invertido, no un
   * tinte. Con el tinte al 6% la tarjeta marcada como `featured` era
   * practicamente indistinguible de sus vecinas y el enfasis se perdia; una
   * pieza solida entre tarjetas claras es lo que hace legible la jerarquia. */
  .ds-card.is-featured {
    border: none;
    background: var(--color-accent);
    color: var(--color-background);
    box-shadow: var(--shadow-lg);
    /* Sobre la superficie de acento, el "acento interior" pasa a ser el color
     * de fondo: pintar una comilla o un chip con `--color-accent` aqui los
     * volveria invisibles contra su propio fondo. */
    --card-accent: var(--color-background);
  }
  .ds-card.is-featured .ds-card-title { color: var(--color-background); }
  /* El chip de icono invierte: superficie translucida clara sobre el acento. */
  .ds-card.is-featured .ds-card-icon-chip {
    background: color-mix(in srgb, var(--color-background) 22%, transparent);
    color: var(--color-background);
  }
  .ds-card.is-featured .ds-card-arrow { color: var(--color-background); }
  /* Texto slotteado (parrafos que aporta la seccion): sin esto, el color
   * heredado del contenido del slot queda en el `--color-text` oscuro sobre la
   * superficie de acento. */
  .ds-card.is-featured :global(p) { color: var(--color-background); }

  /* Area de medios: recorta la imagen y respeta el radio superior de la card. */
  .ds-card-media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-top-left-radius: inherit;
    border-top-right-radius: inherit;
  }
  .ds-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--motion-duration-base) var(--motion-easing);
  }

  /* Elevacion al pasar el puntero/foco en tarjetas enlazables (Req 6.1). */
  a.ds-card:hover,
  a.ds-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  /* Zoom de la imagen cuando la card enlazable esta en hover/foco. */
  a.ds-card:hover .ds-card-media img,
  a.ds-card:focus-visible .ds-card-media img {
    transform: scale(1.05);
  }
  a.ds-card:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .ds-card-title { margin-bottom: var(--space-sm); }

  /* Flecha afordancia solo en tarjetas enlazables. */
  .ds-card-arrow {
    display: inline-block;
    margin-top: var(--space-sm);
    color: var(--color-accent);
    font-weight: 600;
    transition: transform var(--motion-duration-fast) var(--motion-easing);
  }
  a.ds-card:hover .ds-card-arrow,
  a.ds-card:focus-visible .ds-card-arrow { transform: translateX(3px); }

  @media (prefers-reduced-motion: reduce) {
    .ds-card,
    .ds-card-media img,
    .ds-card-arrow { transition: none; }
    a.ds-card:hover,
    a.ds-card:focus-visible { transform: none; }
    a.ds-card:hover .ds-card-media img,
    a.ds-card:focus-visible .ds-card-media img { transform: none; }
    a.ds-card:hover .ds-card-arrow,
    a.ds-card:focus-visible .ds-card-arrow { transform: none; }
  }
</style>
