---
// UI_Component: Button (Req 4.2, 4.5, 6.1, 6.2, 6.3, 8.2).
//
// Renderiza como <a> cuando recibe `href`, o como <button> en caso contrario.
// Color, radio y estados de foco/hover derivan exclusivamente de variables CSS
// de Design_Tokens (Req 4.2, 4.5). La transicion usa las duraciones/curvas de
// motion (Req 6.1, 6.3) y se anula bajo `prefers-reduced-motion: reduce` (Req 6.2).
//
// Direccion editorial/nature: botones confiados de radio pill, peso 600 y
// microinteraccion de elevacion. El prop opcional `arrow` agrega una flecha
// "→" para CTAs, que se desplaza levemente en hover.
interface Props {
  /** Destino del enlace; si se define, se renderiza como <a>. */
  href?: string;
  /** Variante visual (Req 4.2). */
  variant?: "primary" | "ghost";
  /** Tipo del boton nativo cuando no hay href. */
  type?: "button" | "submit" | "reset";
  /** Estado deshabilitado. */
  disabled?: boolean;
  /** Agrega una flecha "→" al final (para CTAs). Opcional. */
  arrow?: boolean;
  /** Clase(s) adicionales opcionales. */
  class?: string;
}
const {
  href,
  variant = "primary",
  type = "button",
  disabled = false,
  arrow = false,
  class: className,
} = Astro.props;
const Tag = href ? "a" : "button";
---
<Tag
  class:list={["ds-button", className]}
  data-variant={variant}
  href={href}
  type={href ? undefined : type}
  aria-disabled={disabled ? "true" : undefined}
  {...disabled && !href ? { disabled: true } : {}}
>
  <span class="ds-button-label"><slot /></span>
  {arrow && <span class="ds-button-arrow" aria-hidden="true">&rarr;</span>}
</Tag>

<style>
  .ds-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-pill);
    border: 1.5px solid transparent;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--motion-duration-base) var(--motion-easing),
      color var(--motion-duration-base) var(--motion-easing),
      border-color var(--motion-duration-base) var(--motion-easing),
      transform var(--motion-duration-fast) var(--motion-easing),
      box-shadow var(--motion-duration-base) var(--motion-easing);
  }

  /* Variante primaria: color de marca solido, texto de contraste claro. */
  .ds-button[data-variant="primary"] {
    background: var(--color-primary);
    color: var(--color-background);
    border-color: var(--color-primary);
  }
  .ds-button[data-variant="primary"]:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  /* Variante ghost: contorno sutil (mezcla texto/primario) sobre transparente. */
  .ds-button[data-variant="ghost"] {
    background: transparent;
    color: var(--color-primary);
    border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-text));
  }
  .ds-button[data-variant="ghost"]:hover {
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  /* Flecha del CTA: se desplaza levemente al pasar el puntero. */
  .ds-button-arrow {
    display: inline-block;
    transition: transform var(--motion-duration-fast) var(--motion-easing);
  }
  .ds-button:hover .ds-button-arrow { transform: translateX(3px); }

  /* Foco visible (Req 8.2). */
  .ds-button:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Estado deshabilitado. */
  .ds-button[disabled],
  .ds-button[aria-disabled="true"] {
    opacity: 0.55;
    cursor: not-allowed;
    pointer-events: none;
    transform: none;
  }

  /* Reduced_Motion: sin desplazamientos ni transiciones (Req 6.2). */
  @media (prefers-reduced-motion: reduce) {
    .ds-button { transition: none; }
    .ds-button:hover { transform: none; }
    .ds-button-arrow { transition: none; }
    .ds-button:hover .ds-button-arrow { transform: none; }
  }
</style>
